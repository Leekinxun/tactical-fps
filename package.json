{
  "name": "breachline-web-fps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "multiplayer-server": "node server/multiplayer-server.mjs",
    "dev:multiplayer": "node server/dev-multiplayer.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.18.2",
    "@babylonjs/core": "9.18.2",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "10.0.0",
    "globals": "16.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
